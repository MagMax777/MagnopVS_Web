<!-- ================= INTERACTIVE HUD SCRIPTS ================= -->
<script>
  (function initCronosHud() {
    // 1. Cronómetro Vivo (120m Countdown)
    let totalSeconds = 6845; // 01:54:05
    let isRunning = true;
    const countdownEl = document.getElementById('countdown-val');
    const pauseBtn = document.getElementById('btn-toggle-pause');
    const skipBtn = document.getElementById('btn-fast-forward');

    function formatTime(sec) {
      const hrs = Math.floor(sec / 3600);
      const mins = Math.floor((sec % 3600) / 60);
      const s = sec % 60;
      return String(hrs).padStart(2, '0') + ':' + 
             String(mins).padStart(2, '0') + ':' + 
             String(s).padStart(2, '0');
    }

    setInterval(() => {
      if (isRunning && totalSeconds > 0) {
        totalSeconds--;
        if (countdownEl) countdownEl.textContent = formatTime(totalSeconds);
      }
    }, 1000);

    if (pauseBtn) {
      pauseBtn.addEventListener('click', () => {
        isRunning = !isRunning;
        pauseBtn.innerHTML = isRunning 
          ? '<span class="material-symbols-outlined text-[18px]">pause</span>' 
          : '<span class="material-symbols-outlined text-[18px] text-primary-container">play_arrow</span>';
      });
    }

    if (skipBtn) {
      skipBtn.addEventListener('click', () => {
        totalSeconds = Math.max(0, totalSeconds - 300); // Salto de 5m
        if (countdownEl) countdownEl.textContent = formatTime(totalSeconds);
      });
    }

    // 2. Baremar: Matriz de cuantificación interactiva
    const sImp = document.getElementById('slider-imp');
    const sUrg = document.getElementById('slider-urg');
    const sImpac = document.getElementById('slider-impac');
    const sDep = document.getElementById('slider-dep');
    const sCost = document.getElementById('slider-cost');

    const vImp = document.getElementById('val-imp');
    const vUrg = document.getElementById('val-urg');
    const vImpac = document.getElementById('val-impac');
    const vDep = document.getElementById('val-dep');
    const vCost = document.getElementById('val-cost');

    const formulaTxt = document.getElementById('formula-txt');
    const scoreBadge = document.getElementById('score-badge');

    function updateBaremar() {
      if (!sImp) return;
      const imp = parseInt(sImp.value, 10);
      const urg = parseInt(sUrg.value, 10);
      const impac = parseInt(sImpac.value, 10);
      const dep = parseInt(sDep.value, 10);
      const cost = parseInt(sCost.value, 10);

      if (vImp) vImp.textContent = imp;
      if (vUrg) vUrg.textContent = urg;
      if (vImpac) vImpac.textContent = impac;
      if (vDep) vDep.textContent = dep;
      if (vCost) vCost.textContent = cost;

      const total = (2 * imp) + urg + impac + dep - cost;
      
      let tag = "CRÍTICA ALTA";
      if (total < 10) tag = "BAJA PRIORIDAD";
      else if (total < 16) tag = "ESTÁNDAR";

      if (formulaTxt) {
        formulaTxt.innerHTML = `VALOR = (2 × ${imp}) + ${urg} + ${impac} + ${dep} − ${cost} = <strong class="text-primary-container font-bold">${total}</strong>`;
      }
      if (scoreBadge) {
        scoreBadge.textContent = `${total} PTS // ${tag}`;
      }
    }

    [sImp, sUrg, sImpac, sDep, sCost].forEach(sl => {
      if (sl) sl.addEventListener('input', updateBaremar);
    });

    // 3. Selectores de Área de Vida
    document.querySelectorAll('.life-area-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.life-area-btn').forEach(b => {
          b.className = "life-area-btn py-1.5 px-1 text-center rounded border border-outline-variant/50 bg-surface-container-low text-on-surface-variant font-orbitron text-[10px] hover:border-primary-container transition-all";
          b.textContent = b.getAttribute('data-area');
        });
        this.className = "life-area-btn py-1.5 px-1 text-center rounded border border-primary-container bg-primary-container/20 text-primary-container font-orbitron text-[10px] font-bold shadow-[0_0_10px_rgba(0,240,255,0.35)]";
        this.textContent = this.getAttribute('data-area') + ' ✦';
      });
    });

    // 4. Selector de Tipo de Bloque
    document.querySelectorAll('.block-type-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.block-type-btn').forEach(b => {
          b.className = "block-type-btn py-1 px-2 text-left rounded border border-outline-variant/40 bg-surface-container-low text-on-surface-variant font-orbitron text-[10px] hover:border-primary-container";
          b.textContent = b.textContent.replace('✦ ', '');
        });
        this.className = "block-type-btn py-1 px-2 text-left rounded border border-primary-container bg-primary-container/20 text-primary-container font-orbitron text-[10px] font-bold shadow-[0_0_8px_rgba(0,240,255,0.3)]";
        if (!this.textContent.includes('✦')) {
          this.textContent = '✦ ' + this.textContent.trim();
        }
      });
    });

    // 5. Selector de Capacidad Disponible
    document.querySelectorAll('.cap-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.cap-btn').forEach(b => {
          b.className = "cap-btn w-full py-1 px-2.5 flex items-center justify-between rounded border border-outline-variant/40 bg-surface-container-low text-on-surface-variant font-orbitron text-[10px] hover:border-secondary";
        });
        this.className = "cap-btn w-full py-1.5 px-2.5 flex items-center justify-between rounded border border-secondary bg-secondary/20 text-secondary font-orbitron text-[10px] font-bold shadow-[0_0_10px_rgba(72,221,193,0.3)]";
      });
    });

    // 6. Botón Sellar Bloque Feedback
    const sealBtn = document.getElementById('btn-seal-block');
    if (sealBtn) {
      sealBtn.addEventListener('click', () => {
        sealBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">check_circle</span> <span>BLOQUE SELLADO</span>';
        sealBtn.classList.remove('bg-secondary');
        sealBtn.classList.add('bg-primary-container', 'text-surface-container-lowest');
      });
    }

    // 7. Botón Encolar Siguiente Bloque
    const enqueueBtn = document.getElementById('btn-enqueue-block');
    if (enqueueBtn) {
      enqueueBtn.addEventListener('click', () => {
        enqueueBtn.innerHTML = '<span class="material-symbols-outlined text-[17px] text-secondary">done_all</span> <span>CRONOS-0143 ENCOLADO CON ÉXITO</span>';
      });
    }
  })();
</script>
