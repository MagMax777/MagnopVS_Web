<!-- BEGIN: Interactive Calculator & Web Audio Real-time Telemetry Engine -->
<script data-purpose="cronos-interactivity">
    // --- Live Value Matrix Calculator ---
    function calculateValue() {
      const imp = parseInt(document.getElementById('slider-importancia').value, 10);
      const urg = parseInt(document.getElementById('slider-urgencia').value, 10);
      const impac = parseInt(document.getElementById('slider-impacto').value, 10);
      const dep = parseInt(document.getElementById('slider-dependencia').value, 10);
      const cost = parseInt(document.getElementById('slider-coste').value, 10);

      document.getElementById('val-importancia').textContent = imp + ' / 5';
      document.getElementById('val-urgencia').textContent = urg + ' / 5';
      document.getElementById('val-impacto').textContent = impac + ' / 5';
      document.getElementById('val-dependencia').textContent = dep + ' / 3';
      document.getElementById('val-coste').textContent = cost + ' / 5';

      // Formula: (2 * Importancia) + Urgencia + Impacto + Dependencia - Coste
      const total = (2 * imp) + urg + impac + dep - cost;

      let label = 'MEDIA';
      if (total >= 18) {
        label = 'CRÍTICA ALTA';
      } else if (total >= 14) {
        label = 'PRIORIDAD ALTA';
      } else if (total >= 10) {
        label = 'ESTÁNDAR';
      } else {
        label = 'BAJA RESISTENCIA';
      }

      document.getElementById('valor-total-display').textContent = total + ' PTS // ' + label;
    }

    // --- High-Fidelity Web Audio API Synthesizer ---
    let audioCtx = null;
    let audioEnabled = true;

    function getAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioCtx = new AudioContextClass();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function toggleAudioEngine() {
      audioEnabled = !audioEnabled;
      const btn = document.getElementById('btn-audio-toggle');
      const txt = document.getElementById('audio-state-text');
      if (audioEnabled) {
        btn.classList.remove('text-slate-500', 'border-slate-700', 'bg-cosmic-surface');
        btn.classList.add('text-neon-mint', 'border-neon-mint', 'bg-neon-mint/10');
        txt.textContent = 'ON (880Hz)';
        playTachyonTone();
      } else {
        btn.classList.add('text-slate-500', 'border-slate-700', 'bg-cosmic-surface');
        btn.classList.remove('text-neon-mint', 'border-neon-mint', 'bg-neon-mint/10');
        txt.textContent = 'MUTE';
      }
    }

    // Tachyon Activation Pulse (880Hz -> 1320Hz arpeggiated ping)
    function playTachyonTone() {
      if (!audioEnabled) return;
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;
        
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, now);
        osc.frequency.exponentialRampToValueAtTime(1320, now + 0.12);

        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start(now);
        osc.stop(now + 0.35);
      } catch (e) {
        console.warn('Audio play error', e);
      }
    }

    // Subtle Bio-acoustic Tick (concentration focus tick)
    function playSubtleTick() {
      if (!audioEnabled) return;
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(1760, now);

        gain.gain.setValueAtTime(0.03, now);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.05);

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start(now);
        osc.stop(now + 0.05);
      } catch (e) {}
    }

    // Solfeggio 528Hz Harmonic Cosmic Transition Bell
    function playCosmicBell() {
      if (!audioEnabled) return;
      try {
        const ctx = getAudioContext();
        if (!ctx) return;
        const now = ctx.currentTime;

        // Fundamental 528 Hz (Miracle tone / transformation) + subtle 1056 Hz harmonic
        const freqs = [528, 1056];
        freqs.forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now);

          const initialVol = idx === 0 ? 0.22 : 0.08;
          gain.gain.setValueAtTime(initialVol, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.8);

          osc.connect(gain);
          gain.connect(ctx.destination);

          osc.start(now);
          osc.stop(now + 1.8);
        });
      } catch (e) {
        console.warn('Audio bell error', e);
      }
    }

    function playTestTone() {
      getAudioContext();
      playTachyonTone();
      setTimeout(playCosmicBell, 380);
    }

    // --- Interactive Tactical Timer Engine ---
    const phases = [
      { name: 'RONDA I (ENTRAR)', duration: 25 * 60, roundNum: '1 / 4 RONDAS', isBreak: false, arcId: 'dial-arc-r1', badgeId: 'badge-r1' },
      { name: 'PAUSA I (RECUPERAR)', duration: 5 * 60, roundNum: 'PAUSA I', isBreak: true, arcId: null, badgeId: null },
      { name: 'RONDA II (CONSTRUIR)', duration: 25 * 60, roundNum: '2 / 4 RONDAS', isBreak: false, arcId: 'dial-arc-r2', badgeId: 'badge-r2' },
      { name: 'PAUSA II (RECUPERAR)', duration: 5 * 60, roundNum: 'PAUSA II', isBreak: true, arcId: null, badgeId: null },
      { name: 'RONDA III (RESOLVER)', duration: 25 * 60, roundNum: '3 / 4 RONDAS', isBreak: false, arcId: 'dial-arc-r3', badgeId: 'badge-r3' },
      { name: 'PAUSA III (RECUPERAR)', duration: 5 * 60, roundNum: 'PAUSA III', isBreak: true, arcId: null, badgeId: null },
      { name: 'RONDA IV (TERMINAR)', duration: 25 * 60, roundNum: '4 / 4 RONDAS', isBreak: false, arcId: 'dial-arc-r4', badgeId: 'badge-r4' },
      { name: 'CIERRE (REGISTRAR)', duration: 5 * 60, roundNum: 'SELLO CIERRE', isBreak: true, arcId: null, badgeId: null }
    ];
    let currentPhaseIndex = 0;
    let timerSeconds = 23 * 60 + 45; // default initial synced to source display
    let timerRunning = true; // Auto-active like HUD operational
    let timerInterval = null;

    function formatTime(totalSec) {
      const m = Math.floor(totalSec / 60);
      const s = totalSec % 60;
      return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }

    function updatePhaseDisplay() {
      const current = phases[currentPhaseIndex];
      document.getElementById('current-phase-label').textContent = current.name;
      document.getElementById('current-phase-count').textContent = current.roundNum;
      document.getElementById('digital-timer').textContent = formatTime(timerSeconds);

      // Update telemetry list items highlighting
      for (let i = 0; i < phases.length; i++) {
        const itemEl = document.getElementById(`phase-item-${i}`);
        const statusEl = document.getElementById(`phase-status-${i}`);
        if (!itemEl || !statusEl) continue;

        if (i < currentPhaseIndex) {
          statusEl.textContent = 'COMPLETO';
          statusEl.className = 'text-neon-mint font-bold text-[10px]';
          itemEl.classList.add('opacity-70');
        } else if (i === currentPhaseIndex) {
          statusEl.textContent = 'EN CURSO';
          statusEl.className = 'text-neon-cyan font-bold text-[10px] animate-pulse';
          itemEl.classList.remove('opacity-70');
          itemEl.classList.add('border-neon-cyan', 'bg-cosmic-surface/90');
        } else {
          statusEl.textContent = i % 2 === 0 ? 'COLA' : 'PENDIENTE';
          statusEl.className = 'text-slate-500 font-bold text-[10px]';
          itemEl.classList.remove('border-neon-cyan', 'bg-cosmic-surface/90', 'opacity-70');
        }
      }

      // Update dial arcs visual intensity
      ['dial-arc-r1', 'dial-arc-r2', 'dial-arc-r3', 'dial-arc-r4'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.setAttribute('opacity', '0.4');
          el.setAttribute('stroke-width', '5');
          el.classList.remove('filter', 'drop-shadow-[0_0_12px_#00f0ff]');
        }
      });

      if (current.arcId) {
        const activeArc = document.getElementById(current.arcId);
        if (activeArc) {
          activeArc.setAttribute('opacity', '1');
          activeArc.setAttribute('stroke-width', '8');
          activeArc.classList.add('filter', 'drop-shadow-[0_0_12px_#00f0ff]');
        }
      }
    }

    function startTimerLoop() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        if (timerSeconds > 0) {
          timerSeconds--;
          document.getElementById('digital-timer').textContent = formatTime(timerSeconds);

          // Subtle bio-acoustic tick on 10-second multiples
          if (timerSeconds % 10 === 0) {
            playSubtleTick();
          }
        } else {
          // Phase finished: trigger Solfeggio 528Hz bell and advance
          playCosmicBell();
          advancePhase();
        }
      }, 1000);
    }

    function toggleTimer() {
      const btn = document.getElementById('btn-toggle-timer');
      const badge = document.getElementById('timer-status-badge');
      getAudioContext();

      if (timerRunning) {
        clearInterval(timerInterval);
        timerRunning = false;
        btn.textContent = 'REANUDAR';
        btn.classList.remove('bg-neon-magenta', 'text-white');
        btn.classList.add('bg-neon-cyan', 'text-black');
        if (badge) {
          badge.textContent = 'PAUSA';
          badge.className = 'text-[10px] text-neon-magenta font-bold px-1.5 py-0.5 rounded bg-neon-magenta/10 border border-neon-magenta/30';
        }
      } else {
        timerRunning = true;
        btn.textContent = 'PAUSAR';
        btn.classList.remove('bg-neon-cyan', 'text-black');
        btn.classList.add('bg-neon-magenta', 'text-white');
        if (badge) {
          badge.textContent = 'ACTIVO';
          badge.className = 'text-[10px] text-neon-mint font-bold px-1.5 py-0.5 rounded bg-neon-mint/10 border border-neon-mint/30';
        }
        playTachyonTone();
        startTimerLoop();
      }
    }

    function advancePhase() {
      getAudioContext();
      currentPhaseIndex = (currentPhaseIndex + 1) % phases.length;
      timerSeconds = phases[currentPhaseIndex].duration;
      playTachyonTone();
      updatePhaseDisplay();
    }

    // --- Real-time Bio-Feedback Simulation & Haptic Heartbeat Engine ---
    let baseBpm = 72;
    let flowIndex = 92;

    function updateBiometrics() {
      // Gentle biological oscillation (BPM 68 - 75)
      const deltaBpm = Math.floor(Math.random() * 3) - 1;
      baseBpm = Math.min(75, Math.max(68, baseBpm + deltaBpm));
      const bpmEl = document.getElementById('bio-bpm');
      if (bpmEl) bpmEl.textContent = baseBpm;

      // HRV ms calculation correlated to coherence
      const hrvVal = Math.round(58 + (75 - baseBpm) * 1.5 + (Math.random() * 3));
      const hrvEl = document.getElementById('bio-hrv');
      if (hrvEl) hrvEl.textContent = `${hrvVal} ms [ÓPTIMA]`;

      // Flow index slight flux 91% - 94%
      if (Math.random() > 0.6) {
        flowIndex = Math.min(95, Math.max(90, flowIndex + (Math.random() > 0.5 ? 1 : -1)));
        const flowEl = document.getElementById('bio-flow');
        const flowBar = document.getElementById('bio-flow-bar');
        if (flowEl) flowEl.textContent = `FLOW ${flowIndex}%`;
        if (flowBar) flowBar.style.width = `${flowIndex}%`;
      }

      // ECG SVG path slight breathing distortion
      const ecg = document.getElementById('ecg-path');
      if (ecg) {
        const peakY = Math.round(4 + Math.random() * 6);
        const lowY = Math.round(30 + Math.random() * 5);
        ecg.setAttribute('d', `M 0 20 L 30 20 L 40 ${peakY + 3} L 46 ${lowY} L 52 ${peakY} L 58 20 L 90 20 L 98 12 L 104 28 L 110 18 L 140 20 L 150 ${peakY + 5} L 156 ${lowY - 2} L 162 20 L 200 20`);
      }

      // Heartbeat pulse sync timing
      const durationSeconds = (60 / baseBpm).toFixed(2);
      const heartEl = document.getElementById('avatar-heart-diamond');
      if (heartEl) {
        heartEl.style.animationDuration = `${durationSeconds}s`;
      }
    }

    // Initialize values and timer on DOM load
    document.addEventListener('DOMContentLoaded', () => {
      calculateValue();
      updatePhaseDisplay();
      startTimerLoop();
      setInterval(updateBiometrics, 2000);
    });
  </script>
<!-- END: Interactive Calculator & Web Audio Real-time Telemetry Engine -->
