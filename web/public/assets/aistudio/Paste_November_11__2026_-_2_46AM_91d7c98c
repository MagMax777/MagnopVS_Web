<script>
    function calculateValue() {
      const i = parseInt(document.getElementById('slider-i').value);
      const u = parseInt(document.getElementById('slider-u').value);
      const imp = parseInt(document.getElementById('slider-imp').value);
      const d = parseInt(document.getElementById('slider-d').value);
      const c = parseInt(document.getElementById('slider-c').value);

      document.getElementById('val-i').textContent = i;
      document.getElementById('val-u').textContent = u;
      document.getElementById('val-imp').textContent = imp;
      document.getElementById('val-d').textContent = d;
      document.getElementById('val-c').textContent = c;

      // Fórmula Cronos: Valor = (2 * I) + U + IMP + D - C
      const total = (2 * i) + u + imp + d - c;
      document.getElementById('total-score').textContent = total + " PTS";
    }
